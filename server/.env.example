PORT=5001
MONGO_URI=your_mongodb_uri
APP_BASE_URL=http://localhost:3000

# Firebase Admin SDK — get from:
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Then choose ONE of the two options below:

# Option A (recommended for local dev): path to the downloaded JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./migraine-genie-service-account.json

# Option B (recommended for production): paste the entire JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"migraine-genie",...}
